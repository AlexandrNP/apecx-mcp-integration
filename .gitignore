# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime / benchmark / cache artifacts produced at execution time
# (deliberately uncommitted — they're sha256-named JSON blobs from the
# WebSearchTool query cache, per-run benchmark output trees, and the
# solution-memory step's in-process state file). Committing them would
# pollute git history with multi-megabyte regenerable artifacts AND
# silently mask cache-vs-source drift in PR diffs.
.web_search_cache/
# Generic on-disk fetch cache: PubMed eFetch/eSearch + other HTTP caches that
# integration tests populate under a worktree. Transient + regenerable; left
# untracked it also blocks `git worktree remove` (must --force) — ignore it.
.cache/
_benchmark_runs/
src/apecx_integration/composition/_runtime/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Secrets / local config
.env
.env.local
*.local.yml
*.local.yaml
# Generated by deploy/install-server.sh (sources deploy/.env at runtime)
deploy/run-mcp.sh

# Runtime artifacts
logs/
*.log
runs/
artifacts/
