# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime / benchmark / cache artifacts produced at execution time
# (deliberately uncommitted — they're sha256-named JSON blobs from the
# WebSearchTool query cache, per-run benchmark output trees, and the
# solution-memory step's in-process state file). Committing them would
# pollute git history with multi-megabyte regenerable artifacts AND
# silently mask cache-vs-source drift in PR diffs.
.web_search_cache/
_benchmark_runs/
src/apecx_integration/composition/_runtime/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Secrets / local config
.env
.env.local
*.local.yml
*.local.yaml

# Runtime artifacts
logs/
*.log
runs/
artifacts/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated bundles (T05)
bundle_*/
pbs_bundle_*/

# Generated figures + presentations (regenerate with docs/figures/build_*.py)
docs/figures/*.png
docs/architecture_slides.pptx
