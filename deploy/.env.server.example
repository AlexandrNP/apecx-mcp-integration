# apecx-mcp SERVER deployment env. Copy to deploy/.env and edit.
#   cp deploy/.env.server.example deploy/.env
# Consumed by deploy/docker-compose.server.yml (variable interpolation). install-server.sh also
# generates deploy/run-mcp.sh, which sources this file so the host `apecx-mcp` process actually
# sees these vars (apecx-mcp reads os.environ only — it does NOT load .env itself).
#
# PORTS + HOSTS LIVE ELSEWHERE NOW. The backend host-ports, the MCP/control-plane/rhea hosts+ports,
# APECX_LLM_BASE_URL and RHEA_MCP_URL are NO LONGER here — they come from deploy/config.yml
# (see deploy/config.yml.example). install-server.sh renders the *_HOST_PORT + APECX_LLM_BASE_URL
# lines from config.yml into the GENERATED deploy/.env.network (do not hand-edit that file); the
# host apecx-mcp reads its own host/port + RHEA_MCP_URL from config.yml via `--config`.
# See deploy/SERVER_DEPLOYMENT.md.

# --- Data-service secrets (REQUIRED; file mode-600) ---------------------------------------
# Leave these EMPTY and install-server.sh generates strong values on first run (openssl rand);
# set them explicitly to override. NEVER commit real values. docker compose fails loud (${VAR:?})
# when a secret is unset, so the old minioadmin/postgres defaults can never reach a deployment.
# Redis has NO password: rhea's redis client (rhea/server/utils.py) passes none, so adding
# `requirepass` needs a rhea-side change first — tracked in SECURITY_AUDIT_PLAN.md, not enabled here.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Backend host ports → deploy/config.yml ------------------------------------------------
# The *_HOST_PORT values (postgres/redis/minio/minio-console/ollama/rhea) are no longer set here.
# Edit them in deploy/config.yml (backends.* + rhea.port); install-server.sh renders them into the
# generated deploy/.env.network, which compose reads alongside this file. The bind host stays
# 127.0.0.1 BY DESIGN (unauthenticated backends, nginx :443 is the only ingress).

# --- Rhea source (REQUIRED) ---------------------------------------------------------------
# The compose builds the Rhea MCP image from this checkout (a sibling clone of the rhea repo).
# install-server.sh resolves this to an absolute path before `docker compose up`.
#   git clone <rhea repo> ../rhea   # as a sibling of this repo
RHEA_REPO_PATH=../rhea
# To use a PREBUILT image instead of building: set RHEA_IMAGE and remove the two `build:` blocks
# from docker-compose.server.yml (the build context is a required var, evaluated even when unused).
#   RHEA_IMAGE=chrisagrams/rhea-server:latest

# --- LLM (Ollama in the compose) ----------------------------------------------------------
# APECX_LLM_BASE_URL is GENERATED into deploy/.env.network from config.yml (backends.ollama_port);
# the run-mcp.sh wrapper sources it so host-run apecx-mcp reaches the compose Ollama.
APECX_LLM_MODEL=nemotron-3-nano:4b
APECX_LLM_API_KEY=unused
# Rhea tool-RAG embedding model (1024-dim — MUST match Rhea's Vector(1024); do NOT use a
# 768-dim model like nomic-embed-text). Pulled by ollama-init; used by ingest AND the server.
RHEA_EMBEDDING_MODEL=mxbai-embed-large
# Galaxy ToolShed repos to ingest (0 = full catalog, slower). Default 25 ≈ 5-10 min first run.
RHEA_INGEST_LIMIT=25

# --- apecx-mcp HTTP transport → deploy/config.yml -----------------------------------------
# The MCP bind host+port live in deploy/config.yml (mcp.host / mcp.port); run-mcp.sh passes
# `--config` so apecx-mcp reads them there. Keep mcp.host = 127.0.0.1 (loopback-only): the nginx
# reverse proxy (deploy/nginx/) is the ONLY externally-reachable surface and forwards to
# 127.0.0.1:8001. Binding 0.0.0.0 would expose the unauthenticated MCP endpoint directly.

# --- Lifecycle ----------------------------------------------------------------------------
# 0 = do NOT let the host apecx-mcp spawn its own infra containers — this compose owns Postgres/
# Redis/MinIO/Ollama; the orchestrator only PROBES them (probe-only does NOT block startup).
APECX_MCP_AUTOSTART_INFRA=0
# The control plane (FastAPI, :8000) is a SEPARATE service from the MCP server (:8001). By
# default apecx-mcp autostarts a control-plane child (on SQLite, :8000) and the MCP tools POST to
# it — leave that default ON. (Do NOT set APECX_MCP_AUTOSTART_BACKEND=0 unless you ALSO either run
# `apecx-cp serve` yourself or set APECX_MCP_SKIP_HEALTHCHECK=1 — otherwise startup exits 2.)
# apecx-mcp derives RHEA_MCP_URL from config.yml (rhea.host + rhea.port) at startup — not set here.

# --- apecx data + Globus (host apecx-mcp needs these) -------------------------------------
# Point at the downloaded dataset + dictionary (run `apecx-setup data dict` on the host once,
# or copy an existing ~/.apecx). Without APECX_DATA_ROOT the database tools return errors
# (the server still starts; harmonized-search + epitope workflows still work via Globus).
APECX_DATA_ROOT=
# Globus creds for the harmonized-search corpus are picked up from the host keyring /
# `apecx-globus-setup login`; no secrets belong in this file.
