# apecx-mcp-integration — operator-supplied environment variables (G82, 2026-05-16)
#
# Copy this file to ``.env`` (NOT versioned — see .gitignore) and fill in
# values for the variables you actually use. The Globus block is required
# only if you want apecx-setup to transfer data via Globus instead of
# falling back to the ``gh release download`` path.
#
# DO NOT COMMIT VALUES. Use this file as a template; per-operator values
# go in your local ``.env`` or your shell rc file.

# ---------------------------------------------------------------------------
# Globus (apecx-setup data — Globus-first transfer path)
# ---------------------------------------------------------------------------

# The Globus collection UUID hosting the VIOLIN + BV-BRC dataset under
# the ``apecx-joshi-anl-general`` path. Ask the data steward (apecx-joshi)
# for the production endpoint UUID, or use a test endpoint UUID for
# development. Operators with their own test endpoint can set this
# locally; the value is read at config-load time only.
#
# Without this variable, apecx-setup falls back to ``gh release download``.
APECX_GLOBUS_SOURCE_ENDPOINT_ID=

# Your Globus Connect Personal endpoint (or any endpoint you can write
# to). Install Globus Connect Personal from
# https://www.globus.org/globus-connect-personal and grab its UUID
# from the Globus web UI (Settings → Endpoints).
APECX_GLOBUS_DEST_ENDPOINT_ID=

# Confidential-client credentials for the Globus Transfer API. Create
# one at https://app.globus.org/settings/developers → "Add app" → choose
# "Confidential client". Both values are normally stored in the OS
# keyring via ``apecx-globus-setup store --client-id <id>
# --client-secret <secret>`` — the env-var path here is for CI or
# containers where the keyring is unavailable.
GLOBUS_COMPUTE_CLIENT_ID=
GLOBUS_COMPUTE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LLM (used by composer + RAG synthesis)
# ---------------------------------------------------------------------------

# OpenAI-compatible chat-completions endpoint. Default is local Ollama.
APECX_LLM_BASE_URL=http://localhost:11434/v1
APECX_LLM_MODEL=mistral-nemo:latest
APECX_LLM_API_KEY=unused

# ---------------------------------------------------------------------------
# Data root + workspace overrides
# ---------------------------------------------------------------------------

# Where apecx-setup writes downloaded data. Default: ~/.apecx/data
# APECX_DATA_ROOT=/path/to/data

# Override the workspace root marker walk. Default: walk upward looking
# for ``apecx-mcp-integration`` directory.
# APECX_WORKSPACE_ROOT=/path/to/workspace
